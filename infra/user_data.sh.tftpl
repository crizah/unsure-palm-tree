#!/bin/bash
# First-boot setup (Lightsail, Ubuntu 24.04). Runs once as root.
# Log: /var/log/cloud-init-output.log
set -eu
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y caddy

# App lives in /opt/foodmap, owned by the default "ubuntu" user (deploys upload here; the service runs as it).
install -d -o ubuntu -g ubuntu /opt/foodmap /opt/foodmap/bin /opt/foodmap/data

cat > /opt/foodmap/.env <<'ENV'
PORT=8080
FRONTEND_URL=${frontend_urls}
ENV
chown ubuntu:ubuntu /opt/foodmap/.env
chmod 640 /opt/foodmap/.env

cat > /etc/systemd/system/foodmap.service <<'UNIT'
[Unit]
Description=Food map API
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/foodmap
ExecStart=/opt/foodmap/bin/server -env /opt/foodmap/.env -db /opt/foodmap/data/places.db -trust-proxy
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=400M

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable foodmap # starts on the first deploy, once the binary exists

# HTTPS reverse proxy. Access logs are discarded on purpose: URLs contain users' coordinates.
cat > /etc/caddy/Caddyfile <<'CADDY'
${api_domain} {
	reverse_proxy 127.0.0.1:8080
	log {
		output discard
	}
}
CADDY
systemctl restart caddy
